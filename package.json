{
  "name": "dsh-tool-fold",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "icon": "./icon.svg",
  "description": "把一批已注册工具折叠成一个查询工具：需要时展开直调，或交给聚合组代执行。Fold registered tools out of the model-visible surface and reveal or proxy them on demand.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tools",
    "tool-surface",
    "progressive-disclosure",
    "mcp"
  ],
  "license": "MIT",
  "author": "Sodapopper-pixel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sodapopper-pixel/dsh-tool-fold.git"
  },
  "homepage": "https://github.com/Sodapopper-pixel/dsh-tool-fold#readme",
  "bugs": {
    "url": "https://github.com/Sodapopper-pixel/dsh-tool-fold/issues"
  },
  "main": "lib/index.js",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CONTEXT.md",
    "docs/screenshot.png",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "sync": "node scripts/sync-installed.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
